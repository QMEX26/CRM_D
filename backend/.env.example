# ===================================================================
# CallingCRM Backend - Environment Configuration Template (.env.example)
# ===================================================================
# Duplicate this file as .env in the backend directory and update the placeholders.
# DO NOT commit .env containing real credentials to GitHub.

# -------------------------------------------------------------------
# Server Port (Render sets this automatically)
# -------------------------------------------------------------------
PORT=8080

# -------------------------------------------------------------------
# Database Configuration (Render PostgreSQL)
# -------------------------------------------------------------------
# Render Internal Connection URL (for backend deployed on Render)
DATABASE_URL=jdbc:postgresql://dpg-dauu8n0473hc73cmm1lg-a:5432/crm_d_db

# Individual database connection parameters
DATABASE_HOST=dpg-dauu8n0473hc73cmm1lg-a
DATABASE_PORT=5432
DATABASE_NAME=crm_d_db
DATABASE_USERNAME=crm_d_db_user
DATABASE_PASSWORD=YOUR_RENDER_POSTGRES_PASSWORD

# Standard PostgreSQL cloud aliases
PGHOST=dpg-dauu8n0473hc73cmm1lg-a
PGPORT=5432
PGDATABASE=crm_d_db
PGUSER=crm_d_db_user
PGPASSWORD=YOUR_RENDER_POSTGRES_PASSWORD

# -------------------------------------------------------------------
# Security & JWT Configuration
# -------------------------------------------------------------------
# Minimum 256-bit (32-character) secret key for JWT HMAC-SHA signing
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS Configuration (Allowed Origins)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://10.97.41.211:8081,http://192.168.1.43:8081,http://localhost:19006,http://192.168.1.43:5173

# -------------------------------------------------------------------
# Google Sheets / Google Apps Script Integration
# -------------------------------------------------------------------
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyOg6Lq8pJKMPkQoVgE__cUwIMvXa0YmHTihK4iHDBsgWY6kMRzKEBXPRmpbQX53CN9/exec
GOOGLE_SCRIPT_SECRET=AKfycbyOg6Lq8pJKMPkQoVgE__cUwIMvXa0YmHTihK4iHDBsgWY6kMRzKEBXPRmpbQX53CN9
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyOg6Lq8pJKMPkQoVgE__cUwIMvXa0YmHTihK4iHDBsgWY6kMRzKEBXPRmpbQX53CN9/exec
GOOGLE_APPS_SCRIPT_SECRET=AKfycbyOg6Lq8pJKMPkQoVgE__cUwIMvXa0YmHTihK4iHDBsgWY6kMRzKEBXPRmpbQX53CN9
GOOGLE_SHEETS_BATCH_SIZE=1000
GOOGLE_SHEETS_CONNECT_TIMEOUT_MS=10000
GOOGLE_SHEETS_READ_TIMEOUT_MS=60000
GOOGLE_SHEETS_MAX_RETRIES=2

# -------------------------------------------------------------------
# Firebase Authentication Configuration
# -------------------------------------------------------------------
FIREBASE_PROJECT_ID=callingcrm-d-472b1
FIREBASE_WEB_API_KEY=AIzaSyB1gM9Oklmrm9IZUwb7kM34Y8Dzk_I4NX0
# Path to service account file (e.g., /etc/secrets/firebase-service-account.json on Render)
FIREBASE_CREDENTIALS_FILE=
# Alternatively, supply the raw JSON string or base64 string directly
FIREBASE_CREDENTIALS_JSON=

# -------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# -------------------------------------------------------------------
# Obtain these from your Razorpay Dashboard (Settings -> API Keys / Webhooks)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# -------------------------------------------------------------------
# Call Tracking & Classification Thresholds (in seconds)
# -------------------------------------------------------------------
CALL_THRESHOLD_VERY_SHORT=30
CALL_THRESHOLD_SHORT=60

# -------------------------------------------------------------------
# JPA / Hibernate & Logging (Optional)
# -------------------------------------------------------------------
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=false
LOGGING_LEVEL_CRM=INFO
LOGGING_LEVEL_SECURITY=INFO
